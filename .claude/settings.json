{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(/infra/hermes-agent/.env.ga)",
      "Read(/infra/hermes-agent/.env.gaw)",
      "Read(/infra/hermes-agent/.env.pr)",
      "Read(/infra/hermes-agent/data/auth.json)",
      "Read(/infra/hermes-agent/data/home/**)",
      "Read(/infra/hermes-agent/data/.claude/**)",
      "Read(/infra/hermes-agent/data/.claude.json)",
      "Edit(**/.env)",
      "Edit(/infra/hermes-agent/.env.ga)",
      "Edit(/infra/hermes-agent/.env.gaw)",
      "Edit(/infra/hermes-agent/.env.pr)",
      "Edit(/infra/hermes-agent/data/auth.json)",
      "Edit(/infra/hermes-agent/data/home/**)",
      "Edit(/infra/hermes-agent/data/.claude/**)",
      "Edit(/infra/hermes-agent/data/.claude.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(node scripts/brain/brain-promote.js *)",
      "Bash(cp * ~/.claude/skills/*)",
      "Bash(cp -r * ~/.claude/skills/*)",
      "Bash(cp -R * ~/.claude/skills/*)",
      "Bash(./install.sh*)",
      "Bash(bash install.sh*)",
      "Bash(./uninstall.sh*)",
      "Bash(bash uninstall.sh*)",
      "Bash(cp * ~/.claude/skills)",
      "Bash(cp * $HOME/.claude/skills*)",
      "Bash(cp * \"$HOME/.claude/skills*)",
      "Bash(cp * \"$HOME\"/.claude/skills*)",
      "Bash(git -C * push *)",
      "Bash(git -C * push)",
      "Bash(git -C * branch -D *)",
      "Bash(node */scripts/brain/brain-promote.js *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/brain/brain-security-guard.sh"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/telemetry/log-invocation.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/telemetry/log-outcome.js\" --mode correction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/telemetry/log-outcome.js\" --mode session-end"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/telemetry/log-outcome.js\" --mode session-end"
          }
        ]
      }
    ]
  }
}
