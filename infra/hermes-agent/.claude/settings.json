{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(/.env.ga)",
      "Read(/.env.gaw)",
      "Read(/.env.pr)",
      "Read(/data/auth.json)",
      "Read(/data/home/**)",
      "Read(/data/.claude/**)",
      "Read(/data/.claude.json)",
      "Edit(**/.env)",
      "Edit(/.env.ga)",
      "Edit(/.env.gaw)",
      "Edit(/.env.pr)",
      "Edit(/data/auth.json)",
      "Edit(/data/home/**)",
      "Edit(/data/.claude/**)",
      "Edit(/data/.claude.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(node scripts/brain/brain-promote.js *)",
      "Bash(cp * ~/.claude/skills/*)",
      "Bash(cp -r * ~/.claude/skills/*)",
      "Bash(cp -R * ~/.claude/skills/*)",
      "Bash(./install.sh*)",
      "Bash(bash install.sh*)",
      "Bash(./uninstall.sh*)",
      "Bash(bash uninstall.sh*)",
      "Bash(cp * ~/.claude/skills)",
      "Bash(cp * $HOME/.claude/skills*)",
      "Bash(cp * \"$HOME/.claude/skills*)",
      "Bash(cp * \"$HOME\"/.claude/skills*)",
      "Bash(git -C * push *)",
      "Bash(git -C * push)",
      "Bash(git -C * branch -D *)",
      "Bash(node */scripts/brain/brain-promote.js *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "d=\"$1\"; while [ -n \"$d\" ]; do if [ -f \"$d/hooks/brain/brain-security-guard.sh\" ]; then exec bash \"$d/hooks/brain/brain-security-guard.sh\"; fi; n=$(dirname \"$d\"); [ \"$n\" = \"$d\" ] && break; d=$n; done; echo \"brain-security-guard not found at or above the project folder of this session ($1); this tool call is BLOCKED (the guard fails closed). Break-glass: docs/SECOND_BRAIN_SECURITY.md\" >&2; exit 2",
              "brain-guard-launcher",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
