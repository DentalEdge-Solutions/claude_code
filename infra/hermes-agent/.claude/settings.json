{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(/.env.ga)",
      "Read(/.env.gaw)",
      "Read(/.env.pr)",
      "Read(/data/auth.json)",
      "Read(/data/home/**)",
      "Read(/data/.claude/**)",
      "Read(/data/.claude.json)",
      "Edit(**/.env)",
      "Edit(/.env.ga)",
      "Edit(/.env.gaw)",
      "Edit(/.env.pr)",
      "Edit(/data/auth.json)",
      "Edit(/data/home/**)",
      "Edit(/data/.claude/**)",
      "Edit(/data/.claude.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(node scripts/brain/brain-promote.js *)",
      "Bash(cp * ~/.claude/skills/*)",
      "Bash(cp -r * ~/.claude/skills/*)",
      "Bash(cp -R * ~/.claude/skills/*)",
      "Bash(./install.sh*)",
      "Bash(bash install.sh*)",
      "Bash(./uninstall.sh*)",
      "Bash(bash uninstall.sh*)",
      "Bash(cp * ~/.claude/skills)",
      "Bash(cp * $HOME/.claude/skills*)",
      "Bash(cp * \"$HOME/.claude/skills*)",
      "Bash(cp * \"$HOME\"/.claude/skills*)",
      "Bash(git -C * push *)",
      "Bash(git -C * push)",
      "Bash(git -C * branch -D *)",
      "Bash(node */scripts/brain/brain-promote.js *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "-c",
              "for g in \"$1/hooks/brain/brain-security-guard.sh\" \"$1/../../hooks/brain/brain-security-guard.sh\"; do if [ -f \"$g\" ]; then exec bash \"$g\"; fi; done; echo '{\"systemMessage\":\"brain-security-guard not found from this session (CLAUDE_PROJECT_DIR); this tool call was not checked\"}'; exit 0",
              "brain-guard-launcher",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
