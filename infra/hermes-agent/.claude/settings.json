{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(/.env.ga)",
      "Read(/.env.gaw)",
      "Read(/.env.pr)",
      "Read(/data/auth.json)",
      "Read(/data/home/**)",
      "Read(/data/.claude/**)",
      "Read(/data/.claude.json)",
      "Edit(**/.env)",
      "Edit(/.env.ga)",
      "Edit(/.env.gaw)",
      "Edit(/.env.pr)",
      "Edit(/data/auth.json)",
      "Edit(/data/home/**)",
      "Edit(/data/.claude/**)",
      "Edit(/data/.claude.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(node scripts/brain/brain-promote.js *)",
      "Bash(cp * ~/.claude/skills/*)",
      "Bash(cp -r * ~/.claude/skills/*)",
      "Bash(cp -R * ~/.claude/skills/*)",
      "Bash(./install.sh*)",
      "Bash(bash install.sh*)",
      "Bash(./uninstall.sh*)",
      "Bash(bash uninstall.sh*)",
      "Bash(cp * ~/.claude/skills)",
      "Bash(cp * $HOME/.claude/skills*)",
      "Bash(cp * \"$HOME/.claude/skills*)",
      "Bash(cp * \"$HOME\"/.claude/skills*)"
    ]
  }
}
