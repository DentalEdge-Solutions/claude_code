# infra/hermes-agent/.env.example — copy to `.env` (gitignored). NO real values here.

# --- Hermes's OWN reasoning model (the control plane) ---
# Pick ONE provider (or a local OpenAI-compatible endpoint). Configure via `hermes model`.
# Model-economy note: use the cheapest model that clears the bar for control-plane routing.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# (local: point Hermes at Ollama/vLLM/llama.cpp — no key)

# --- Claude Code, invoked by Hermes as `claude -p` in project dirs ---
ANTHROPIC_API_KEY=

# --- OpenAI-compatible API server (only if you enable it) ---
# Leave OFF for a local-only control plane. If enabled and bound non-loopback,
# API_SERVER_KEY is MANDATORY (min 8 chars).
# API_SERVER_ENABLED=false
# API_SERVER_HOST=127.0.0.1
# API_SERVER_KEY=

# --- Hermes web dashboard (browser UI: embedded-TUI chat + config/sessions/logs/kanban) ---
# The dashboard is an s6-supervised service, OFF unless HERMES_DASHBOARD is truthy.
# It binds 0.0.0.0 inside the container so the loopback-only host port-map
# (127.0.0.1:9119 in docker-compose.yml) can reach it. Per the June-2026 hardening,
# a non-loopback bind REQUIRES an auth provider (--insecure no longer bypasses it):
# set a basic-auth username + password (bundled provider, no external IDP).
# HERMES_DASHBOARD=1
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=            # set a strong value in .env
# HERMES_DASHBOARD_HOST=0.0.0.0                    # default; leave unless you know better
# HERMES_DASHBOARD_PORT=9119                       # default; must match the compose port-map

# --- Governance store (mutation tier) ---
# Absolute host path to the governance store. Must be OUTSIDE this repo (the repo is
# bind-mounted into the container) and OUTSIDE ./data (the one read-write mount).
# Create it mode 700. Compose does not expand ~, so write the path in full.
HERMES_GOVERNANCE_DIR=/absolute/path/to/.hermes/governance
