# infra/hermes-agent/config.yaml.example
# Version-controlled TEMPLATE for Hermes's control-plane config.
#
# The LIVE file is ./data/config.yaml (gitignored — it lives in HERMES_HOME,
# /opt/data inside the container). This template exists so a fresh deploy
# (e.g. the P4 VPS) reproduces the same control-plane setup deterministically.
#
# To apply on a fresh box:
#   cp config.yaml.example data/config.yaml   # then `docker compose up -d`
#   (or run the `hermes config set` commands in README.md)
#
# NO SECRETS HERE. API keys live ONLY in .env:
#   OPENROUTER_API_KEY  -> Hermes's own control-plane model (OpenRouter credits)
#   (no Anthropic key on the gateway: drafts run in ads-drafter with /etc/hermes/.env.anthropic)

model:
  # Control-plane reasoning runs on a cheap OSS model via OpenRouter (D14/D15 economy).
  # History: local qwen2.5:7b was too weak to orchestrate; Sonnet 5 worked but is expensive.
  # DeepSeek V3.2 is the cost/reliability pick for tool-orchestration; swap freely if flaky
  # (alternates: nousresearch/hermes-4-70b, qwen/qwen3-235b-a22b-2507, z-ai/glm-4.6).
  # NOTE: `claude -p` (the executor) stays DIRECT on Anthropic — this only sets Hermes's brain.
  default: "deepseek/deepseek-v3.2"
  provider: "openrouter"

terminal:
  # Hermes runs `claude -p` in mounted project dirs via the local backend.
  backend: "local"
  cwd: "."
  timeout: 300

# OpenRouter privacy. Hermes sends provider_routing.data_collection as provider.data_collection
# (spec §13). Zero Data Retention is enforced by the OpenRouter ACCOUNT privacy setting (Hermes has
# no zdr key; spec §13).
provider_routing:
  data_collection: "deny"

# Option B (spec 2026-09-30 §3.1): the ONE app Hermes may trigger, as three MCP tools. The broker
# on the host is the boundary; this block only gives the model typed tools instead of a shell.
mcp_servers:
  ads_audit:
    command: "python3"
    args: ["/opt/cc-bin/hermes-app-mcp.py", "--app", "ads-audit"]
    env: {}
    timeout: 360
    tools:
      include: [ads_audit_run, ads_audit_status, ads_audit_list]
      resources: false
      prompts: false
